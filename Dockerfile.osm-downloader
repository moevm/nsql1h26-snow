FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends osmium-tool wget ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY <<'EOF' /download.sh
set -e

PBF_FILE="/tmp/region.osm.pbf"
OSM_FILE="/osm_data/saint-petersburg.osm"

if [ -f "$OSM_FILE" ]; then
  echo "OSM file already exists, skipping download."
  exit 0
fi

echo "Downloading North-Western Russia PBF from Geofabrik (~609 MB)..."
wget -q -O "$PBF_FILE" "$PBF_URL"

echo "Extracting Saint Petersburg bbox ($BBOX) and converting to OSM XML..."
osmium extract -b "$BBOX" "$PBF_FILE" -o "$OSM_FILE"

rm -f "$PBF_FILE"
echo "Done:"
ls -lh "$OSM_FILE"
EOF

RUN sed -i 's/\r$//' /download.sh && chmod +x /download.sh

ENTRYPOINT ["/bin/sh", "/download.sh"]
